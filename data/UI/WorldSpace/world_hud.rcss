/* Screen-space overlay of the world-space demo. */

#hint {
	position: absolute;
	left: 24dp;
	bottom: 24dp;
	width: 430dp;
	padding: 16dp 18dp;
}

#hint .title {
	font-size: 24dp;
}

.page {
	margin-top: 10dp;
	font-size: 14dp;
}

.gap {
	margin-top: 6dp;
}

.keys {
	margin-top: 10dp;
	font-size: 13dp;
	color: #ecd7ad;
}

/* The layer the markers live in: the whole screen, letting clicks through to the scene. */
#markers {
	position: absolute;
	left: 0;
	top: 0;
	width: 100vw;
	height: 100vh;
}

/*
 * A marker is positioned by its top-left corner (style.left / style.top from code), so the
 * content is shifted left by half its width to centre it on the point.
 */
.marker {
	position: absolute;
	width: 180dp;
	margin-left: -90dp;
	text-align: center;
	pointer-events: none;
}

/* A white glyph tinted gold. */
.marker .diamond {
	width: 26dp;
	height: 26dp;
	margin-left: 77dp;
	decorator: image(glyph-target);
	image-color: #ffd36a;
}

.marker .label {
	margin-top: 4dp;
	font-family: "Kenney Future";
	font-size: 14dp;
	color: #ffe7a8;
	font-effect: outline(2dp #3b2414);
}

/* ---------- small screens ---------- */

@media (max-height: 560dp) {
	#hint {
		left: 4.5vw;
		bottom: 2vh;
		width: 300dp;
		padding: 8dp 12dp;
	}

	#hint .title {
		font-size: 14dp;
	}

	.page {
		margin-top: 4dp;
		padding: 5dp 8dp;
		font-size: 10dp;
	}

	.gap {
		margin-top: 3dp;
	}

	.keys {
		margin-top: 4dp;
		font-size: 10dp;
	}

	.marker .label {
		font-size: 11dp;
	}
}

@media (max-width: 760dp) {
	#hint {
		left: 3vw;
		bottom: 2vh;
		width: 94vw;
		padding: 12dp;
	}
}
