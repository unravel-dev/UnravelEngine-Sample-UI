/* Data Models demo layout. Frames, buttons and controls come from app:/data/UI/Shared/theme.rcss. */

body {
	background-color: rgba(10, 6, 2, 150);
}

#header {
	position: absolute;
	left: 0;
	top: 20dp;
	width: 100vw;
	text-align: center;
}

#shop {
	position: absolute;
	left: 5vw;
	top: 120dp;
	width: 54vw;
}

#player {
	position: absolute;
	right: 5vw;
	top: 120dp;
	width: 33vw;
}

#shop .section, #player .section:first-child {
	margin-top: 0dp;
}

.small {
	font-size: 14dp;
}

label.toggle {
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 15dp;
	color: #ecd7ad;
}

label.toggle input.checkbox {
	margin-right: 6dp;
}

/* ---------- shop rows (data-for clones) ---------- */

.item {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 8dp 12dp 8dp 8dp;
	margin-bottom: 8dp;
}

/* The icon sits in a wooden slot; 34 px pixel art at 2x. */
.slot {
	width: 80dp;
	height: 80dp;
	margin-right: 14dp;
	decorator: ninepatch(square-brown, square-brown-inner);
}

.slot img {
	display: block;
	width: 68dp;
	height: 68dp;
	margin: 4dp 0dp 0dp 6dp;
}

.item-text {
	flex: 1;
}

.item-name {
	font-family: "Kenney Future";
	font-size: 18dp;
	color: #5c3d26;
}

/* data-class-rare / data-class-epic colour the name and the rarity line. */
.item-rarity {
	font-size: 13dp;
	color: #8a6a4a;
}

.item.rare .item-name, .item.rare .item-rarity { color: #2b62a8; }
.item.epic .item-name, .item.epic .item-rarity { color: #7b3fa0; }

.owned {
	font-size: 18dp;
	color: #2f7d3a;
	margin-left: 6dp;
}

.item-info {
	font-size: 13dp;
	color: #7a5a3c;
	margin-top: 2dp;
}

.price {
	width: 120dp;
	text-align: right;
	font-size: 22dp;
	color: #7a4f2c;
	margin-right: 10dp;
}

.price img {
	width: 34dp;
	height: 34dp;
	margin-right: 4dp;
	vertical-align: middle;
}

/* data-class-locked: the player cannot afford it. */
.item.locked .price { color: #b03a2e; }

.item button {
	margin-left: 8dp;
	padding: 7dp 14dp 11dp 14dp;
	font-size: 14dp;
}

.item button:active {
	padding: 9dp 14dp 9dp 14dp;
}

/* ---------- player ---------- */

.purse-coin {
	width: 68dp;
	height: 68dp;
	margin-right: 10dp;
}

#gold {
	font-size: 44dp;
	color: #ffe7a8;
	font-effect: outline(3dp #3b2414);
}

#player button {
	margin-left: 8dp;
}

#message {
	min-height: 22dp;
	margin-top: 8dp;
	font-size: 15dp;
}

progress {
	margin: 4dp 0dp 6dp 0dp;
}

.form {
	padding: 14dp 16dp;
}

.field {
	margin-bottom: 10dp;
}

.field .label {
	width: 110dp;
	color: #5c3d26;
}

.field input.text, .field input.range, .field select {
	flex: 1;
}

#greeting {
	margin-top: 6dp;
	font-size: 15dp;
	color: #4a3423;
}

#greeting .name {
	font-family: "Kenney Future";
	color: #9a4a1c;
}

/* ---------- small screens ---------- */

/* The two columns keep to the screen and scroll inside; the rows drop what they can. */
@media (max-height: 760dp) {
	#shop,
	#player {
		bottom: 2vh;
		height: auto;
		overflow-y: auto;
	}
}

@media (max-height: 560dp) {
	#header {
		top: 8dp;
	}

	#header .subtitle,
	.item-info {
		display: none;
	}

	#shop {
		left: 4.5vw;
		top: 40dp;
		width: 52vw;
	}

	#player {
		right: 4.5vw;
		top: 40dp;
		width: 37vw;
	}

	.item {
		padding: 4dp 8dp 4dp 4dp;
		margin-bottom: 4dp;
	}

	.slot {
		width: 44dp;
		height: 44dp;
		margin-right: 8dp;
	}

	.slot img {
		width: 36dp;
		height: 36dp;
		margin: 3dp 0dp 0dp 4dp;
	}

	.item-name {
		font-size: 12dp;
	}

	.item-rarity,
	.small,
	label.toggle {
		font-size: 11dp;
	}

	.owned {
		font-size: 13dp;
	}

	.price {
		width: 64dp;
		margin-right: 2dp;
		font-size: 14dp;
	}

	.price img {
		width: 18dp;
		height: 18dp;
		margin-right: 2dp;
	}

	.item button {
		margin-left: 4dp;
		padding: 4dp 7dp 7dp 7dp;
		font-size: 10dp;
	}

	.item button:active {
		padding: 6dp 7dp 5dp 7dp;
	}

	.purse-coin {
		width: 36dp;
		height: 36dp;
		margin-right: 6dp;
	}

	#gold {
		font-size: 26dp;
	}

	#player button {
		margin-left: 4dp;
	}

	#message {
		margin-top: 2dp;
		font-size: 12dp;
	}

	.form {
		padding: 8dp 10dp;
		font-size: 12dp;
	}

	.field {
		margin-bottom: 6dp;
	}

	.field .label {
		width: 70dp;
	}

	.field select {
		width: 120dp;
	}

	#greeting {
		font-size: 12dp;
	}
}

@media (max-width: 760dp) {
	#header {
		top: 11vh;
	}

	#header .subtitle,
	.item-info {
		display: none;
	}

	#shop {
		left: 3vw;
		top: 18vh;
		bottom: 40vh;
		width: 94vw;
		height: auto;
		overflow-y: auto;
	}

	#player {
		left: 3vw;
		right: auto;
		top: 61vh;
		bottom: 2vh;
		width: 94vw;
		height: auto;
		overflow-y: auto;
	}

	.slot {
		width: 48dp;
		height: 48dp;
	}

	.slot img {
		width: 40dp;
		height: 40dp;
		margin: 3dp 0dp 0dp 4dp;
	}

	.price {
		width: 76dp;
		font-size: 16dp;
	}
}
